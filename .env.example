# Flask API 服务器环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改配置

# Flask 应用配置
FLASK_ENV=production
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
FLASK_SECRET_KEY=your-secret-key-here

# MongoDB Cloud Configuration
# 优先级：MONGODB_CLOUD_URI > 构建的URI > 本地fallback URI

# 方式1：直接使用完整的MongoDB Cloud URI
# MONGODB_CLOUD_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority&appName=LvTong

# 方式2：分别配置各个组件（系统会自动构建URI）
MONGODB_USERNAME=your_username
MONGODB_PASSWORD=your_password
MONGODB_CLUSTER=your_cluster.mongodb.net
MONGODB_DATABASE=lvtong
MONGODB_APP_NAME=LvTong

# 本地MongoDB fallback（当云配置不可用时使用）
MONGODB_URI=mongodb://localhost:27017/lvtong

# 其他数据库配置（如果需要）
# DATABASE_URL=postgresql://username:password@localhost:5432/dbname
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=myapp

# Redis配置（如果使用Redis）
# REDIS_URL=redis://localhost:6379/0
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0

# JWT配置（如果使用JWT认证）
# JWT_SECRET_KEY=your-jwt-secret-key
# JWT_ACCESS_TOKEN_EXPIRES=3600

# 邮件配置（如果需要发送邮件）
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password

# 文件上传配置
# MAX_CONTENT_LENGTH=16777216  # 16MB
# UPLOAD_FOLDER=uploads

# 日志配置
# LOG_LEVEL=INFO
# LOG_FILE=app.log

# Azure OpenAI Configuration
# GPT-4o model configuration
AZURE_AI_API_KEY_4O=your_azure_openai_api_key
AZURE_AI_ENDPOINT_4O=https://your-resource.openai.azure.com/openai/deployments/your-deployment/chat/completions?api-version=2024-02-15-preview

# Legacy OpenAI Configuration (if needed)
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_VERSION=2024-02-15-preview

# 其他第三方API配置
# ALIYUN_ACCESS_KEY_ID=your-aliyun-access-key-id
# ALIYUN_ACCESS_KEY_SECRET=your-aliyun-access-key-secret

# 域名配置（生产环境）
# DOMAIN_NAME=api.yourdomain.com
# SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
# SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# ========================================
# 使用说明：
# ========================================
# 1. 复制此文件为 .env：cp .env.example .env
# 2. 填入你的实际配置值
# 3. 确保 .env 文件已添加到 .gitignore 中
# 4. 重启应用以加载新的环境变量
#
# MongoDB配置说明：
# - 推荐使用方式2（分别配置各组件），系统会自动构建连接URI
# - 如果你有完整的连接字符串，可以直接使用MONGODB_CLOUD_URI
# - 本地开发时可以使用MONGODB_URI连接本地MongoDB
#
# Azure OpenAI配置说明：
# - 需要在Azure Portal创建OpenAI资源
# - AZURE_AI_ENDPOINT_4O需要包含完整的部署URL和API版本
# - 确保API密钥有足够的权限访问指定的部署